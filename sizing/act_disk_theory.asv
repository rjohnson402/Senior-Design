clear
% Flight Conditions
rho = 0.002048; % value for air density
kin_nu = 3.68041e-7; % kinematic viscosity
nu = 3.68041e-7; % dynamic viscosity, lb s / ft^2

KT2FPS   = 1.688;

u_0_kts = 100; % kts
u_0 = u_0_kts .* KT2FPS; % value for initial velocity



% Define the initial parameters
W = 1500; % weight, lbs
S_ref = 140; % wing reference area, ft^2
AR = 12;
num_props = 8;

e_osw = 0.8;
XL = 24.0; % Fuselage length, ft^2
WFus = 3.66; % max fuselage width, ft^2
DFus = 4.16; % max fuselage depth, ft^2
Cf_w    = 0.0033;
FF_w    = 1.30;
Cf_t    = 0.0036;
FF_t    = 1.20;
Cf_m    = 0.0040;
FF_m    = 1.30;
excr    = 1.13; % excrescence and interference factor
SMISC   = 48.4; % Misc stuff area, ft^2
FFc = 1;
WETR = 2.05;
SHT = 20;
SVT = 10;

% Lift
L = W;
CL = 2 .* L ./ ( rho .* u_0.^2 .* S_ref);
% Drag
Ref   = u_0.*XL./nu;                            % fuselage Reynolds number
Cf_f  = 0.455./log10(Ref).^2.58;              % Prandtl-Schlichting flat plate
fineness = XL/((WFus + DFus)/2);
FF_f  = 1 + 60/fineness^3 + fineness/400;
DAV = (WFus + DFus) / 2;                        % Eq. 57
SWFUS = pi() * (XL / DAV - 1.7) * DAV^2;    % Eq. 61
f_fus = Cf_f*FF_f*SWFUS*excr;               % fuselage drag area, ft^2
f_msc = Cf_m*FF_m*SMISC*excr;
f_wing = Cf_w*FF_w*S_ref*WETR*excr;
f_tail = Cf_t*FF_t*WETR*(SHT + SVT)*excr;
f      = f_wing + f_tail + f_fus + f_msc;
CD0    = f/S_ref;
CDi    = CL.^2/(pi*AR*e_osw);
LD     = CL./(CD0 + CDi)
D      = L./LD;

T_tot = D;
T_per_prop = T_tot / num_props;

T = T_per_prop;
A_prop = pi * 3^2; % value for area property

u_e = (u_0) * (T / (A_prop * u_0.^2 * rho / 2) + 1)^(1/2);

u_disk = (u_0/2) * (T / (A_prop * u_0.^2 * rho / 2) + 1)^(1/2) + u_0/2;

diff = u_e - u_0;

plot(u_0, diff)
grid on